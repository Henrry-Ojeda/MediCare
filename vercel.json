{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/downloads/MediCare.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"MediCare.apk\"" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/descargar", "destination": "/descargar.html" },
    { "source": "/((?!assets/|downloads/|descargar\\.html|sw\\.js|manifest\\.webmanifest).*)", "destination": "/index.html" }
  ]
}
